# Copy to .env on the payment server only. Never paste keys into chat or Git.
PUBLIC_ORIGIN=https://pay.example.com
HOST=127.0.0.1
PORT=8787
# Generate with: openssl rand -hex 32
SESSION_SECRET=
DATABASE_FILE=/var/lib/aipm-checkout/orders.sqlite
DOWNLOAD_FILE=/srv/aipm-private/ai-pm-resume.zip

# Native payment; all WeChat fields required to enable this method.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat-private.pem
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_KEY_FILE=/run/secrets/wechat-platform-public.pem
WECHAT_PLATFORM_KEY_ID=

# Alipay Face-to-face Payment; RSA2 / PKCS8 application private key.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay-public.pem
